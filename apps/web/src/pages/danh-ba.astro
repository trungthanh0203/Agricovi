---
import Base from '../layouts/Base.astro';
import Pager from '../components/Pager.astro';
import ShopCard from '../components/ShopCard.astro';
import { esc, loadDirectoryPage, profileCard } from '../lib/db';
import { loadShops } from '../lib/catalog';

// Danh bạ phân trang ở CSDL (24 cơ sở mỗi trang); bộ lọc là biểu mẫu GET nên mỗi trang có địa chỉ riêng và được lưu đệm ở biên.
const sp = Astro.url.searchParams;
const q = (sp.get('q') ?? '').trim().slice(0, 80);
const tinh = (sp.get('tinh') ?? '').slice(0, 80);
const conHang = sp.get('con-hang') === '1';
const trang = Math.min(Math.max(parseInt(sp.get('trang') ?? '1', 10) || 1, 1), 1000);
let dir: Awaited<ReturnType<typeof loadDirectoryPage>> | null = null;
let error = '';
try { dir = await loadDirectoryPage({ q, province: tinh, available: conHang, page: trang, size: 24 }); } catch (e) { error = e instanceof Error ? e.message : String(e); }
const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');
const SHOP_MAX = 12;
const shopsAll = !conHang ? (await loadShops()).filter((s) => (!tinh || s.province === tinh) && (!q || q.split(/\s+/).every((w) => fold([s.name, s.province, s.district, s.description].join(' ')).includes(fold(w))))) : [];
const shops = shopsAll.slice(0, SHOP_MAX);
const provinces = dir?.provinces ?? [];
---
<Base title="Danh bạ cơ sở — Agricovi" description="Danh bạ cơ sở sản xuất nông nghiệp đã được kiểm duyệt.">
  <h1>Danh bạ cơ sở</h1>
  <form class="filters" method="get">
    <input name="q" value={q} placeholder="Tìm theo tên cơ sở hoặc sản phẩm" aria-label="Tìm kiếm" />
    <select name="tinh" aria-label="Tỉnh/thành"><option value="">Tất cả tỉnh/thành</option>{provinces.map((p) => <option selected={p === tinh}>{p}</option>)}</select>
    <label class="ck"><input type="checkbox" name="con-hang" value="1" checked={conHang} /> Chỉ nơi đang có hàng</label>
    <button class="btn solid" type="submit">Lọc</button>
  </form>
  {error && <p class="err">{error}</p>}
  {dir && <p class="muted">{dir.total} cơ sở{dir.pages > 1 ? ` · trang ${dir.page}/${dir.pages}` : ''}</p>}
  <div class="grid">
    {dir && dir.rows.length === 0 && <p class="empty">Không tìm thấy cơ sở phù hợp.</p>}
    {dir && <Fragment set:html={dir.rows.map((d) => profileCard(d, dir!.snaps.get(d.profile_id), dir!.prods.get(d.profile_id) ?? [], dir!.badges.get(d.profile_id))).join('')} />}
  </div>
  {dir && <Pager page={dir.page} pages={dir.pages} />}
  {shops.length > 0 && (
    <>
      <h2>Gian hàng vật tư</h2>
      <div class="grid">{shops.map((s) => <ShopCard s={s} />)}</div>
      {shopsAll.length > SHOP_MAX && <p class="muted">Còn {shopsAll.length - SHOP_MAX} gian hàng khác: hãy nhập từ khóa hoặc chọn tỉnh/thành để thu hẹp.</p>}
    </>
  )}
</Base>
