---
import Base from '../layouts/Base.astro';
import { COMING_SOON_SECTIONS, DEFAULT_PAGES, parseBody, type Block } from '@agriconnect/shared';
import { loadPage } from '../lib/site';
import { localizePage } from '../lib/translations';

// Trang tĩnh do quản trị viên soạn (CMS) hoặc nội dung mặc định; mục sắp ra mắt hiện thông báo thay vì lỗi 404.
const parts = (Astro.params.slug ?? '').split('/').filter(Boolean);
const first = parts[0] ?? '';
let page: { title: string; description: string; body: string } | null = null;
let soon = '';
if (parts.length === 1 && /^[a-z0-9]+(-[a-z0-9]+)*$/.test(first)) {
  page = (await loadPage(first)) ?? DEFAULT_PAGES[first] ?? null;
}
if (page) page = localizePage(page, first, Astro.locals.tr);
if (!page && COMING_SOON_SECTIONS[first]) soon = COMING_SOON_SECTIONS[first]!;
if (!page && !soon) Astro.response.status = 404;
const blocks: Block[] = page ? parseBody(page.body) : [];
// Ảnh minh họa cho một số trang giới thiệu
const PAGE_IMG: Record<string, { src: string; alt: string }> = {
  'danh-cho-nguoi-ban': { src: '/brand/photo-seller.webp', alt: 'Nhà vườn dùng Agricovi để ghi chép trong nhà màng' },
  'huong-dan-ban-hang': { src: '/brand/photo-guide.webp', alt: 'Người trồng xem ứng dụng Agricovi ngay tại vườn' },
  'gioi-thieu': { src: '/brand/photo-about.webp', alt: 'Agricovi — nông nghiệp thông minh, kết nối thương mại' },
};
const pageImg = parts.length === 1 ? PAGE_IMG[first] : undefined;
---
{page && (
  <Base title={`${page.title} — Agricovi`} description={page.description || undefined}>
    <article class="prose">
      <h1>{page.title}</h1>
      {pageImg && <img class="pageimg" src={pageImg.src} alt={pageImg.alt} width="1200" height="626" decoding="async" />}
      {blocks.map((b) => (
        b.t === 'h' ? <h2>{b.text}</h2>
        : b.t === 'p' ? <p>{b.text}</p>
        : b.t === 'ul' ? <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
        : <p><a class="btn solid" href={b.href}>{b.label}</a></p>
      ))}
    </article>
  </Base>
)}
{!page && soon && (
  <Base title={`${soon} — Agricovi`} noindex cache={false}>
    <div class="panel" style="max-width:640px;margin:32px auto;text-align:center">
      <h1>{soon}</h1>
      <p class="muted">Mục này đang được chuẩn bị và sẽ sớm ra mắt.</p>
      <p><a class="btn solid" href="/">Về trang chủ</a> <a class="btn outline" href="/danh-ba/">Xem nhà cung cấp</a></p>
    </div>
  </Base>
)}
{!page && !soon && (
  <Base title="Không tìm thấy trang — Agricovi" noindex cache={false}>
    <div class="panel" style="max-width:640px;margin:32px auto;text-align:center">
      <h1>Không tìm thấy trang</h1>
      <p class="muted">Địa chỉ này không tồn tại hoặc đã được chuyển.</p>
      <p><a class="btn solid" href="/">Về trang chủ</a></p>
    </div>
  </Base>
)}
