---
import Base from '../../layouts/Base.astro';
---
<Base title="Tin giao thương của tôi — Agricovi" noindex cache={false}>
  <div id="app"><p class="muted">Đang tải…</p></div>
</Base>

<script>
  import { TRADE_KIND_LABEL, TRADE_STATUS_LABEL } from '@agriconnect/shared';
  import { call, friendly, loadAccount, session } from '../../lib/auth';
  import { esc } from '../../lib/db';

  const app = document.getElementById('app')!;
  interface Mine { id: string; kind: string; title: string; status: string; review_note: string | null; expires_at: string; created_at: string; expired: boolean; open_responses: number; responses: number }
  const note = (cls: string, t: string) => `<p class="${cls}" role="${cls === 'err' ? 'alert' : 'status'}">${esc(t)}</p>`;

  async function main() {
    if (!(await session())) { location.replace('/dang-nhap/?next=' + encodeURIComponent('/giao-thuong/cua-toi/')); return; }
    try { await loadAccount(); } catch (e) { app.innerHTML = note('err', friendly(e)); return; }
    await render(new URLSearchParams(location.search).get('moi') ? note('ok', 'Đã gửi tin. Tin đang chờ kiểm duyệt; bạn sẽ nhận thông báo khi được duyệt.') : new URLSearchParams(location.search).get('sua') ? note('ok', 'Đã lưu thay đổi. Tin sẽ hiển thị lại sau khi được kiểm duyệt.') : '');
  }
  async function render(msg = '') {
    let list: Mine[] = [];
    try { list = await call<Mine[]>('list_my_trade_posts'); } catch (e) { app.innerHTML = note('err', friendly(e)); return; }
    app.innerHTML = `<h1>Tin giao thương của tôi</h1>${msg}<p><a class="btn solid" href="/giao-thuong/dang-tin/">+ Đăng tin mới</a> <a class="btn outline" href="/hop-thu/">Hộp thư</a></p>
      ${list.length === 0 ? '<p class="empty">Bạn chưa đăng tin nào.</p>' : list.map((p) => {
        const live = (p.status === 'published' && !p.expired);
        const st = p.expired && p.status === 'published' ? 'Đã hết hạn' : TRADE_STATUS_LABEL[p.status] ?? p.status;
        return `<div class="panel"><span class="tk ${esc(p.kind)}">${esc(TRADE_KIND_LABEL[p.kind] ?? p.kind)}</span> <span class="stat ${live ? 'ok' : p.status === 'pending' ? 'warn' : 'bad'}">${esc(st)}</span>
          <h3 style="margin:.3em 0"><a href="/giao-thuong/tin/${esc(p.id)}">${esc(p.title)}</a></h3>
          <span class="muted">Hạn ${esc(new Date(p.expires_at).toLocaleDateString('vi-VN'))} · ${p.responses} ${p.kind === 'buy' ? 'báo giá' : 'người quan tâm'}${p.open_responses ? ` (<b>${p.open_responses} chưa xử lý</b>)` : ''}</span>
          ${p.review_note ? `<br><span class="muted">Ghi chú kiểm duyệt: ${esc(p.review_note)}</span>` : ''}
          ${p.status !== 'closed' ? `<p style="margin:.5em 0 0"><a class="btn sm" href="/giao-thuong/dang-tin/?sua=${esc(p.id)}">Sửa tin</a> ${p.status === 'published' || p.status === 'pending' ? `<button class="btn sm" data-ext="${esc(p.id)}">Gia hạn 14 ngày</button> <button class="btn sm danger" data-close="${esc(p.id)}">Đóng tin</button>` : '<span class="muted">Sửa xong, tin được gửi duyệt lại.</span>'}</p>` : ''}</div>`;
      }).join('')}`;
    app.querySelectorAll<HTMLElement>('[data-ext]').forEach((b) => b.addEventListener('click', async () => { try { await call('extend_trade_post', { p_id: b.dataset.ext, p_days: 14 }); await render(note('ok', 'Đã gia hạn.')); } catch (e) { await render(note('err', friendly(e))); } }));
    app.querySelectorAll<HTMLElement>('[data-close]').forEach((b) => b.addEventListener('click', async () => { if (!confirm('Đóng tin này?')) return; try { await call('close_trade_post', { p_id: b.dataset.close }); await render(note('ok', 'Đã đóng tin.')); } catch (e) { await render(note('err', friendly(e))); } }));
  }
  void main();
</script>
