---
import Base from '../../layouts/Base.astro';
---
<Base title="Chi tiết đơn hàng — Agricovi" noindex cache={false}>
  <p class="crumbs"><a href="/don-hang/">← Đơn hàng</a></p>
  <div id="app"><p class="muted">Đang tải…</p></div>
</Base>

<script>
  import { ORDER_STATUS_LABEL, PAYMENT_LABEL } from '@agriconnect/shared';
  import { call, friendly, loadAccount, session } from '../../lib/auth';
  import { esc } from '../../lib/db';
  import { fmtVnd } from '../../lib/catalog';

  const app = document.getElementById('app')!;
  const id = location.pathname.replace(/\/+$/, '').split('/').pop() ?? '';
  interface Item { id: string; listing_id: string | null; name: string; unit: string | null; list_price: number | string | null; unit_price: number | string | null; quantity: number | string; agreed_quantity: number | string | null }
  interface Ev { kind: string; role: string; from: string | null; to: string | null; note: string | null; at: string }
  interface Order {
    id: string; code: string; side: 'buyer' | 'seller'; status: string; payment_status: string; supplier_name: string; profile_slug: string | null; recipient: string; recipient_phone: string; province: string; district: string | null; address: string;
    desired_date: string | null; buyer_note: string | null; seller_note: string | null; shipping_fee: number | string; deliver_date: string | null; total: number | string | null; cancel_reason: string | null;
    buyer_name: string | null; supplier_contact: { phone?: string; address?: string; zalo?: string } | null; actions: string[]; items: Item[]; events: Ev[];
  }
  const KIND: Record<string, string> = { created: 'Đặt hàng', quoted: 'Báo giá', accept: 'Đồng ý báo giá', cancel: 'Hủy đơn', receive: 'Xác nhận đã nhận hàng', reject: 'Từ chối đơn', prepare: 'Bắt đầu chuẩn bị', ship: 'Bắt đầu giao', deliver: 'Đã giao', seller_cancel: 'Nhà cung cấp hủy', payment: 'Cập nhật thanh toán', auto_completed: 'Tự hoàn tất' };
  const ACT: Record<string, [string, string, boolean]> = {
    accept: ['Đồng ý báo giá', 'solid', false], cancel: ['Hủy đơn', 'danger', true], receive: ['Đã nhận hàng', 'solid', false],
    reject: ['Từ chối đơn', 'danger', true], prepare: ['Bắt đầu chuẩn bị hàng', 'solid', false], ship: ['Bắt đầu giao hàng', 'solid', false], deliver: ['Đã giao xong', 'solid', false], seller_cancel: ['Hủy đơn (hết hàng/sự cố)', 'danger', true],
  };
  const note = (cls: string, t: string) => `<p class="${cls}" role="${cls === 'err' ? 'alert' : 'status'}">${esc(t)}</p>`;
  const tone = (s: string) => (s === 'completed' || s === 'delivered' ? 'ok' : s === 'cancelled' || s === 'rejected' ? 'bad' : 'warn');
  const money = (v: number | string | null) => (v == null ? '—' : fmtVnd(Number(v)));
  const fdate = (d: string) => new Date(d).toLocaleDateString('vi-VN');

  async function main() {
    if (!(await session())) { location.replace('/dang-nhap/?next=' + encodeURIComponent(location.pathname)); return; }
    try { await loadAccount(); } catch (e) { app.innerHTML = note('err', friendly(e)); return; }
    await render(new URLSearchParams(location.search).get('moi') ? note('ok', 'Đã gửi đơn. Nhà cung cấp sẽ xem và báo giá cho bạn; bạn sẽ nhận thông báo.') : '');
  }

  async function render(msg = '') {
    let o: Order;
    try { o = await call<Order>('get_order', { p_id: id }); } catch (e) { app.innerHTML = note('err', friendly(e)); return; }
    const seller = o.side === 'seller';
    const canQuote = o.actions.includes('quote');
    const rows = o.items.map((i) => {
      const q = i.agreed_quantity ?? i.quantity;
      const line = i.unit_price != null ? Number(i.unit_price) * Number(q) : null;
      if (canQuote) {
        return `<tr><td>${esc(i.name)}<br><small class="muted">Giá tham khảo: ${i.list_price != null ? fmtVnd(Number(i.list_price)) : '—'}</small></td>
          <td><input type="number" min="0" step="any" data-qi="${esc(i.id)}" value="${esc(q)}" style="width:80px" /> ${esc(i.unit ?? '')}<br><small class="muted">đặt ${esc(i.quantity)}</small></td>
          <td><input type="number" min="0" step="any" data-pi="${esc(i.id)}" value="${i.unit_price != null ? esc(i.unit_price) : ''}" style="width:100px" /> đ</td><td></td></tr>`;
      }
      return `<tr><td>${esc(i.name)}</td><td>${esc(q)} ${esc(i.unit ?? '')}${i.agreed_quantity != null && Number(i.agreed_quantity) !== Number(i.quantity) ? `<br><small class="muted">đặt ${esc(i.quantity)}</small>` : ''}</td>
        <td>${i.unit_price != null ? fmtVnd(Number(i.unit_price)) : '—'}</td><td style="text-align:right">${line != null ? fmtVnd(line) : '—'}</td></tr>`;
    }).join('');
    const quoted = o.status !== 'placed';
    app.innerHTML = `${msg}
      <h1 style="margin-bottom:4px">Đơn ${esc(o.code)} <span class="stat ${tone(o.status)}">${esc(ORDER_STATUS_LABEL[o.status] ?? o.status)}</span></h1>
      <p class="muted">${seller ? 'Người mua: <b>' + esc(o.buyer_name ?? '') + '</b>' : 'Nhà cung cấp: <b>' + (o.profile_slug ? `<a href="/co-so/${encodeURIComponent(o.profile_slug)}">${esc(o.supplier_name)}</a>` : esc(o.supplier_name)) + '</b>'}
        · Thanh toán: <b>${esc(PAYMENT_LABEL[o.payment_status] ?? o.payment_status)}</b> (ghi nhận bởi nhà cung cấp, thanh toán thực hiện ngoài website)</p>
      ${o.cancel_reason ? `<p class="err">Lý do: ${esc(o.cancel_reason)}</p>` : ''}
      <div class="panel"><table class="list" style="width:100%"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th style="text-align:right">Thành tiền</th></tr></thead><tbody>${rows}</tbody>
        <tfoot><tr><td colspan="3">Phí giao hàng</td><td style="text-align:right">${canQuote ? `<input type="number" min="0" step="any" id="ship" value="${esc(o.shipping_fee)}" style="width:100px" /> đ` : quoted ? fmtVnd(Number(o.shipping_fee)) : '—'}</td></tr>
        <tr><td colspan="3"><b>Tổng cộng</b></td><td style="text-align:right"><b>${quoted ? money(o.total) : 'Chờ báo giá'}</b></td></tr></tfoot></table>
        ${canQuote ? `<div class="formgrid"><label>Ngày giao dự kiến<input type="date" id="ddate" value="${esc(o.deliver_date ?? '')}" /></label><label>Ghi chú cho người mua<input id="qnote" maxlength="300" value="${esc(o.seller_note ?? '')}" /></label></div>
          <p class="muted">Nhập đơn giá cho mọi dòng. Có thể giảm số lượng nếu không đủ hàng (không tăng quá số đặt).</p>` : ''}</div>
      <div class="panel"><b>Giao tới:</b> ${esc(o.recipient)} · ${esc(o.recipient_phone)}<br>${esc([o.address, o.district, o.province].filter(Boolean).join(', '))}
        ${o.desired_date ? `<br>Muốn nhận trước ngày: ${esc(fdate(o.desired_date))}` : ''}${o.buyer_note ? `<br>Ghi chú của người mua: ${esc(o.buyer_note)}` : ''}
        ${o.deliver_date && !canQuote ? `<br>Ngày giao dự kiến: ${esc(fdate(o.deliver_date))}` : ''}${o.seller_note && !canQuote ? `<br>Ghi chú của nhà cung cấp: ${esc(o.seller_note)}` : ''}
        ${!seller && o.supplier_contact ? `<br><b>Liên hệ nhà cung cấp:</b> ${esc(Object.values(o.supplier_contact).filter(Boolean).join(' · '))}` : ''}</div>
      <p id="amsg"></p>
      <p class="btnrow">${o.actions.map((a) => a === 'quote' ? `<button class="btn solid" data-a="quote">${o.status === 'quoted' ? 'Báo giá lại' : 'Gửi báo giá'}</button>` : a === 'payment' ? '' : `<button class="btn ${ACT[a]?.[1] ?? 'outline'}" data-a="${a}">${esc(ACT[a]?.[0] ?? a)}</button>`).join(' ')}
        ${!seller ? '<button class="btn outline" data-a="reorder">Mua lại</button>' : ''}</p>
      ${o.actions.includes('payment') ? `<div class="panel"><b>Ghi nhận thanh toán</b> <select id="pay">${Object.entries(PAYMENT_LABEL).map(([k, v]) => `<option value="${k}"${k === o.payment_status ? ' selected' : ''}>${esc(v)}</option>`).join('')}</select> <button class="btn sm" data-a="payment">Lưu</button></div>` : ''}
      <div id="rv"></div>
      <h3>Lịch sử đơn</h3>
      <ul class="muted" style="padding-left:1.1em">${o.events.map((e) => `<li>${esc(new Date(e.at).toLocaleString('vi-VN'))} — ${e.role === 'system' ? 'Hệ thống' : e.role === 'seller' ? 'Nhà cung cấp' : 'Người mua'}: <b>${esc(KIND[e.kind] ?? e.kind)}</b>${e.note ? ' — ' + esc(e.note) : ''}</li>`).join('')}</ul>
      <p class="muted">Đơn đặt hàng là yêu cầu mua gửi nhà cung cấp; hệ thống chưa thu tiền. Khi có tranh chấp, hãy nhắn qua <a href="/hop-thu/">Hộp thư</a> hoặc báo cho ban quản trị.</p>`;

    void renderReview(o);
    const msgEl = document.getElementById('amsg')!;
    const fail = (x: unknown) => { msgEl.innerHTML = note('err', friendly(x)); };
    app.querySelectorAll<HTMLButtonElement>('[data-a]').forEach((b) => b.addEventListener('click', async () => {
      const a = b.dataset.a!;
      b.disabled = true;
      try {
        if (a === 'reorder') { const n = await call<number>('reorder', { p_order: id }); location.assign(n > 0 ? '/gio-hang/' : '/don-hang/'); return; }
        if (a === 'quote') {
          const items = o.items.map((i) => ({ id: i.id, unit_price: (app.querySelector<HTMLInputElement>(`[data-pi="${i.id}"]`)!.value || null), quantity: (app.querySelector<HTMLInputElement>(`[data-qi="${i.id}"]`)!.value || null) }));
          await call('quote_order', { p_id: id, p_items: items, p_shipping: Number((document.getElementById('ship') as HTMLInputElement).value || 0), p_note: (document.getElementById('qnote') as HTMLInputElement).value, p_date: (document.getElementById('ddate') as HTMLInputElement).value || null });
          await render(note('ok', 'Đã gửi báo giá cho người mua.')); return;
        }
        if (a === 'payment') {
          await call('set_order_payment', { p_id: id, p_status: (document.getElementById('pay') as HTMLSelectElement).value, p_note: null });
          await render(note('ok', 'Đã ghi nhận thanh toán.')); return;
        }
        let reason: string | null = null;
        if (ACT[a]?.[2]) { reason = prompt(ACT[a]![0] + ' — nhập lý do (ít nhất 5 ký tự, không ghi số điện thoại/email):'); if (!reason) { b.disabled = false; return; } }
        else if (a === 'receive' && !confirm('Xác nhận bạn đã nhận đủ hàng?')) { b.disabled = false; return; }
        await call('order_action', { p_id: id, p_action: a, p_note: reason });
        await render(note('ok', 'Đã cập nhật đơn.'));
      } catch (x) { fail(x); b.disabled = false; }
    }));
  }
  interface Rv { side: string; can_review: boolean; review: { id: string; stars: number; comment: string | null; reply: string | null; status: string; hidden_reason: string | null; flagged: boolean } | null }
  const starsOf = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
  async function renderReview(o: Order) {
    const box = document.getElementById('rv');
    if (!box || (o.status !== 'completed')) return;
    let r: Rv;
    try { r = await call<Rv>('get_order_review', { p_order: id }); } catch { return; }
    if (r.review) {
      const v = r.review;
      box.innerHTML = `<div class="panel"><b>Đánh giá của người mua:</b> <span style="color:#b45309">${starsOf(v.stars)}</span>${v.status === 'hidden' ? ' <span class="stat bad">Đang bị ẩn</span>' : ''}${v.comment ? `<p style="margin:.3em 0">${esc(v.comment)}</p>` : ''}${v.reply ? `<p class="muted" style="margin:.3em 0"><b>Trả lời:</b> ${esc(v.reply)}</p>` : ''}${r.side === 'seller' && !v.reply && v.status === 'visible' ? '<p class="muted">Bạn trả lời đánh giá ở trang <a href="/danh-gia/">Đánh giá của khách</a>.</p>' : ''}</div>`;
    } else if (r.can_review) {
      box.innerHTML = `<form class="panel form mini" id="rvf"><b>Đánh giá nhà cung cấp</b> <span class="muted">(chỉ một lần, trong 30 ngày; hiện công khai với tên rút gọn)</span>
        <label>Số sao<select name="stars"><option value="5">★★★★★ Rất hài lòng</option><option value="4">★★★★ Hài lòng</option><option value="3">★★★ Bình thường</option><option value="2">★★ Chưa hài lòng</option><option value="1">★ Rất không hài lòng</option></select></label>
        <label>Nhận xét (không ghi số điện thoại, email; từ 2 sao trở xuống cần nêu lý do)<textarea name="comment" rows="3" maxlength="300"></textarea></label>
        <p class="err" id="rvm" role="alert"></p><button class="btn solid" type="submit">Gửi đánh giá</button></form>`;
      document.getElementById('rvf')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const d = new FormData(e.target as HTMLFormElement);
        const btn = (e.target as HTMLElement).querySelector('button')!; btn.disabled = true;
        try { await call('review_order', { p_order: id, p_stars: Number(d.get('stars')), p_comment: d.get('comment') }); await render(note('ok', 'Cảm ơn bạn đã đánh giá.')); }
        catch (x) { document.getElementById('rvm')!.textContent = friendly(x); btn.disabled = false; }
      });
    }
  }
  void main();
</script>
