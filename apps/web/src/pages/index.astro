---
import Base from '../layouts/Base.astro';
import { safeHref } from '@agriconnect/shared';
import ProductCard from '../components/ProductCard.astro';
import MaterialCard from '../components/MaterialCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TradeCard from '../components/TradeCard.astro';
import ShopCard from '../components/ShopCard.astro';
import Section from '../components/Section.astro';
import Rail from '../components/Rail.astro';
import { loadTradePosts } from '../lib/trade';
import { catHref, catTree, descendantIds, loadArticles, loadCategories, loadMaterials, loadProducts, loadShops, today } from '../lib/catalog';
import { esc, img, loadDirectory, profileCard, supplyPill, type DirRow } from '../lib/db';
import { loadChrome } from '../lib/site';
import { localizeArticle } from '../lib/translations';

const chrome = await loadChrome();
const brand = chrome.settings.brand.name ?? 'Agricovi';
const hero = chrome.banners.filter((b) => b.slot === 'hero').slice(0, 6);
const sideDefault = [
  { id: 'd1', title: 'Giao thương', subtitle: 'Đăng tin cần mua, cần bán', image: '', link: '/giao-thuong/' },
  { id: 'd2', title: 'Dành cho người bán', subtitle: 'Dùng thử ứng dụng quản lý sản xuất', image: '', link: '/danh-cho-nguoi-ban' },
];
const sideBanners = chrome.banners.filter((b) => b.slot === 'side').slice(0, 2);
const side = sideBanners.length ? sideBanners : sideDefault;

const cats = await loadCategories();
const { top: topCats, kids } = catTree(cats);
const CAT_ICON: Record<string, string> = {
  'rau-cu-qua': '🥬', 'trai-cay': '🍊', 'vat-nuoi': '🐄', 'gao-nong-san-kho': '🌾', giong: '🌱', 'vat-tu-nong-nghiep': '🧪', 'phu-kien-thiet-bi': '🧰',
};
const allProducts = await loadProducts();
const materials = (await loadMaterials()).slice(0, 10);
const articles = (await loadArticles()).map((a) => localizeArticle(a, Astro.locals.tr));
const rowFor = (slug: string) => {
  const c = cats.find((x) => x.slug === slug);
  if (!c) return null;
  const ids = descendantIds(cats, c.id);
  return { cat: c, items: allProducts.filter((p) => p.categoryId && ids.has(p.categoryId)).slice(0, 12) };
};
const rowOf: Record<string, NonNullable<ReturnType<typeof rowFor>>> = {};
for (const [blockId, slug] of [['trai_cay', 'trai-cay'], ['rau_cu_qua', 'rau-cu-qua'], ['vat_nuoi', 'vat-nuoi']] as const) {
  const r = rowFor(slug);
  if (r && r.items.length > 0) rowOf[blockId] = r;
}
const blocks = chrome.home.filter((b) => b.on);
const trades = (await loadTradePosts()).slice(0, 10);
const day = today();
const latest = articles.filter((a) => a.channel !== 'hoi_cho' || !a.end || a.end >= day || a.publishedAt).slice(0, 10);
let dirError = '';
const shopsHome = (await loadShops()).slice(0, 6);
let featured: string[] = [];
let available: string[] = [];
try {
  const { rows, snaps, prods, badges } = await loadDirectory();
  featured = rows.slice(0, 12).map((d) => profileCard(d, snaps.get(d.profile_id), prods.get(d.profile_id) ?? [], badges.get(d.profile_id)));
  const byId = new Map<string, DirRow>(rows.map((r) => [r.profile_id, r]));
  for (const [pid, list] of prods) {
    const d = byId.get(pid);
    if (!d) continue;
    for (const p of list) {
      if (p.supply_status !== 'available') continue;
      const pic = img(p.snapshot.images?.[0]?.src);
      available.push(`<a class="card" href="/co-so/${encodeURIComponent(d.slug)}">
        ${pic ? `<img class="cover" src="${pic}" alt="" loading="lazy" />` : '<div class="cover ph">🥬</div>'}
        <div class="body"><h3>${esc(p.snapshot.name)}</h3>${supplyPill(p.supply_status)}
        <p class="muted">${esc(d.display_name)} · ${esc(d.province ?? '')}</p>
        <p class="muted">${esc([p.snapshot.price_note, p.snapshot.min_order && 'tối thiểu ' + p.snapshot.min_order].filter(Boolean).join(' · '))}</p></div></a>`);
    }
  }
  available = available.slice(0, 14);
} catch (e) {
  dirError = e instanceof Error ? e.message : String(e);
}
---
<Base title={`${brand} — Kết nối nông nghiệp Việt`} description={chrome.settings.brand.description}>
  <section class="hero2">
    <nav class="catbox" aria-label="Danh mục sản phẩm">
      <div class="cathead">☰ Danh mục sản phẩm</div>
      <ul class="catlist">
        {topCats.map((c) => (
          <li>
            <a href={catHref(c)}><span class="ci" aria-hidden="true">{CAT_ICON[c.slug] ?? '📦'}</span><span class="cn">{c.name}</span><span class="car" aria-hidden="true">›</span></a>
            {(kids.get(c.id)?.length ?? 0) > 0 && (
              <div class="fly">
                <div class="fly-h"><b>{c.name}</b><a href={catHref(c)}>Xem tất cả<span aria-hidden="true"> →</span></a></div>
                <ul class="fly-list">
                  {kids.get(c.id)!.map((k) => (
                    <li>
                      <a href={catHref(k)}>{k.name}</a>
                      {(kids.get(k.id)?.length ?? 0) > 0 && <div class="fly-sub">{kids.get(k.id)!.slice(0, 5).map((g) => <a href={catHref(g)}>{g.name}</a>)}</div>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <Rail full class="herorail">
      {hero.length === 0 && (
        <div class="slide fallback">
          <div class="herotop">
            <h1>Tìm nơi trồng, sản phẩm và nguồn gốc nông sản</h1>
            <img class="herologo" src="/brand/logo-horizontal.webp" alt={brand} height="30" />
          </div>
          <div class="heromid">
            <p>Danh bạ nhà cung cấp đã được kiểm duyệt, tình trạng cung ứng cập nhật thường xuyên và truy xuất nguồn gốc từng mùa vụ.</p>
            <a class="btn cta1" href="/danh-ba/">Xem nhà cung cấp</a>
          </div>
          <div class="herotrade">
            <a class="btn cta3" href="/giao-thuong/">🤝 Giao thương</a>
            <p>Đăng tin cần mua, cần bán và trao đổi trực tiếp với người mua, nhà cung cấp đã đăng ký. Liên hệ chỉ mở khi hai bên cùng đồng ý.</p>
          </div>
        </div>
      )}
      {hero.map((b) => (
        <a class="slide" href={b.link || '#'}>
          {b.image && <img src={b.image} alt={b.title} />}
          <span class="cap"><b>{b.title}</b>{b.subtitle && <small>{b.subtitle}</small>}</span>
        </a>
      ))}
    </Rail>

    <div class="sidebans">
      {sideBanners.length > 0 ? side.map((b) => (
        <a class="sideban" href={safeHref(b.link) || '#'}>
          {b.image && <img src={b.image} alt="" />}
          <span><b>{b.title}</b>{b.subtitle && <small>{b.subtitle}</small>}</span>
        </a>
      )) : (
        <>
          <a class="promo buyer" href="/danh-cho-nguoi-mua">
            <span class="pico" aria-hidden="true">🛒</span>
            <b class="pt">Cho người mua</b>
            <small class="ps">Tìm nguồn nông sản uy tín, xem rõ nguồn gốc</small>
            <ul><li>Tìm nhà cung cấp đã kiểm duyệt</li><li>Truy xuất nguồn gốc bằng mã QR</li></ul>
            <span class="pgo">Tìm nhà cung cấp<span aria-hidden="true"> →</span></span>
          </a>
          <a class="promo seller" href="/danh-cho-nguoi-ban">
            <span class="pico" aria-hidden="true">🌾</span>
            <b class="pt">Cho người bán</b>
            <small class="ps">Quản lý sản xuất và đưa sản phẩm đến nhiều người mua</small>
            <ul><li>Nhật ký, kho, chi phí, chấm công</li><li>Hồ sơ website và mã QR từng vụ</li></ul>
            <span class="pgo">Bắt đầu miễn phí<span aria-hidden="true"> →</span></span>
          </a>
        </>
      )}
    </div>
  </section>

  <div class="duo">
    <section class="duo-card trace">
      <span class="duo-ico" aria-hidden="true">🔎</span>
      <div class="duo-body">
        <h2>Kiểm tra nguồn gốc</h2>
        <p>Nhập mã vụ in trên bao bì để xem quá trình sản xuất của lô hàng.</p>
        <form class="duo-form" action="/truyxuat/" method="get">
          <input name="ma" placeholder="Ví dụ VU-1A2B3C4D" aria-label="Mã vụ" />
          <button class="btn solid" type="submit">Truy xuất</button>
        </form>
      </div>
    </section>
    <section class="duo-card grower">
      <span class="duo-ico" aria-hidden="true">🌾</span>
      <div class="duo-body">
        <h2>Bạn là nhà vườn hay hợp tác xã?</h2>
        <p>Ghi chép sản xuất, truy xuất nguồn gốc và giới thiệu sản phẩm đến người mua. Dùng thử miễn phí.</p>
        <a class="btn" href="/danh-cho-nguoi-ban">Tìm hiểu thêm</a>
      </div>
    </section>
  </div>

  {blocks.map((b) => (
    b.id === 'giao_thuong' ? (
      <Section title="Giao thương" icon="🤝" href="/giao-thuong/">
        {trades.length > 0 ? <Rail w={270}>{trades.map((t) => <TradeCard t={t} />)}</Rail> : (
          <div class="soon">
            <b>Giao thương: người mua đăng tin cần mua, nhà cung cấp đăng tin cần bán</b>
            <p class="muted">Khách xem được danh sách; đăng nhập để xem chi tiết và trao đổi. Chưa có tin nào, hãy <a href="/giao-thuong/dang-tin/">đăng tin đầu tiên</a>.</p>
          </div>
        )}
      </Section>
    ) : b.id === 'nha_cung_cap' ? (
      <>
        <Section title="Nhà cung cấp sản phẩm" icon="🏡" href="/danh-ba/">
          {dirError && <p class="err">{dirError}</p>}
          {!dirError && featured.length === 0 && <p class="empty">Chưa có cơ sở nào được công khai.</p>}
          {featured.length > 0 && <Rail w={260}><Fragment set:html={featured.join('')} /></Rail>}
        </Section>
        {shopsHome.length > 0 && (
          <Section title="Gian hàng bán vật tư" icon="🧪" href="/vat-tu/" more="Xem thêm">
            <Rail w={260}>{shopsHome.map((s) => <ShopCard s={s} />)}</Rail>
          </Section>
        )}
      </>
    ) : b.id === 'dang_co_hang' ? (
      <Section title="Đang có hàng" icon="✅" href="/danh-ba/" more="Xem thêm">
        {!dirError && available.length === 0 && <p class="empty">Hiện chưa có sản phẩm nào báo "Đang có hàng".</p>}
        {available.length > 0 && <Rail w={250}><Fragment set:html={available.join('')} /></Rail>}
      </Section>
    ) : rowOf[b.id] ? (
      <Section title={rowOf[b.id]!.cat.name} icon={CAT_ICON[rowOf[b.id]!.cat.slug] ?? '📦'} href={catHref(rowOf[b.id]!.cat)} more="Xem thêm">
        <Rail w={200}>{rowOf[b.id]!.items.map((p) => <ProductCard p={p} />)}</Rail>
      </Section>
    ) : b.id === 'vat_tu' && materials.length > 0 ? (
      <Section title="Vật tư nông nghiệp" icon="🧪" href="/vat-tu/" more="Xem thêm">
        <Rail w={200}>{materials.map((m) => <MaterialCard m={m} />)}</Rail>
      </Section>
    ) : b.id === 'tin' && latest.length > 0 ? (
      <Section title="Sự kiện, hội chợ và tin tức" icon="📰" href="/tin-nong-nghiep/">
        <Rail w={260}>{latest.map((a) => <ArticleCard a={a} />)}</Rail>
      </Section>
    ) : null
  ))}
</Base>

<style is:global>
  .hero2 { position: relative; display: grid; grid-template-columns: 230px minmax(0, 1fr) 250px; gap: 14px; margin-bottom: 14px; }
  .catbox { background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); align-self: start; position: relative; z-index: 12; }
  .cathead { background: linear-gradient(90deg, var(--g-d), var(--g)); color: #fff; font-weight: 700; padding: 11px 14px; border-radius: 15px 15px 0 0; }
  .catlist { list-style: none; margin: 0; padding: 4px 0; }
  .catlist > li > a { display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .catlist .ci { width: 24px; text-align: center; font-size: 1.15rem; } .catlist .cn { flex: 1; } .catlist .car { color: var(--muted); }
  .catlist > li:hover > a, .catlist > li:focus-within > a { background: var(--g2); color: var(--g-d); }
  .catlist > li:hover .car { color: var(--g); }
  /* Menu con hiện bên phải khi trỏ chuột (hoặc dùng bàn phím) */
  .catlist > li { position: static; }
  .fly { display: none; position: absolute; left: calc(100% - 2px); top: 0; min-height: 100%; width: min(430px, 60vw); background: #fff; border: 1px solid var(--line); border-radius: 0 16px 16px 0; box-shadow: 12px 10px 30px rgba(16,40,26,.18); padding: 16px 20px 18px; z-index: 30; }
  .catlist > li:hover > .fly, .catlist > li:focus-within > .fly { display: block; }
  .fly-h { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid var(--g2); padding-bottom: 8px; margin-bottom: 10px; }
  .fly-h b { font-size: 1.1rem; color: var(--g-d); } .fly-h a { font-size: .9rem; font-weight: 600; text-decoration: none; }
  .fly-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 22px; }
  .fly-list > li > a { font-weight: 600; color: var(--ink); text-decoration: none; display: block; padding: 4px 0; }
  .fly-list > li > a:hover { color: var(--g); }
  .fly-sub { display: flex; flex-direction: column; gap: 2px; padding-left: 10px; border-left: 2px solid var(--g2); }
  .fly-sub a { font-size: .88rem; color: var(--muted); text-decoration: none; } .fly-sub a:hover { color: var(--g); text-decoration: underline; }

  .hero2 > * { min-width: 0; }
  .herorail { border-radius: 16px; box-shadow: var(--shadow); min-height: 300px; }
  .herorail .rail { border-radius: 16px; min-height: 300px; background: var(--g2); }
  .slide { flex: 0 0 100%; scroll-snap-align: start; position: relative; display: block; text-decoration: none; color: inherit; min-height: 300px; }
  .slide img { width: 100%; height: 100%; min-height: 300px; object-fit: cover; display: block; }
  .slide .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 22px 18px; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.65)); display: flex; flex-direction: column; font-size: 1.15rem; }
  .slide .cap small { font-size: .9rem; opacity: .95; }
  .slide.fallback { background: radial-gradient(circle at 85% 20%, rgba(255,255,255,.18) 0 90px, transparent 91px), radial-gradient(circle at 95% 90%, rgba(255,216,74,.35) 0 120px, transparent 121px), linear-gradient(135deg, #0f5f2f, #1e9650); color: #fff; padding: 34px 32px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 10px; }
  .slide.fallback .kicker { background: rgba(255,255,255,.18); border-radius: 999px; padding: 3px 12px; font-size: .8rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .slide.fallback h1 { margin: 0; font-size: 2rem; line-height: 1.2; max-width: 520px; } .slide.fallback p { margin: 0 0 8px; opacity: .95; max-width: 520px; }
  .slide.fallback { align-items: stretch; gap: 12px; } .slide.fallback h1 { max-width: none; }
  .herotop { display: flex; align-items: center; gap: 16px; } .herotop h1 { flex: 1; } .herologo { flex: none; height: 30px; width: auto; display: block; background: #fff; border-radius: 8px; padding: 4px 8px; box-sizing: content-box; }
  .heromid { display: flex; align-items: center; gap: 16px; } .heromid p { margin: 0 !important; flex: 1; max-width: none !important; } .heromid .btn { flex: none; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .herotrade { display: flex; align-items: center; gap: 14px; margin-top: 6px; flex-wrap: wrap; } .herotrade .btn { flex: none; } .herotrade p { margin: 0; font-size: .86rem; flex: 1 1 220px; max-width: 360px; line-height: 1.4; opacity: .95; }
  .btn.cta3 { background: linear-gradient(135deg, #efe7ff, #d8c8fb); color: #3b1d7a; box-shadow: 0 3px 10px rgba(124,77,214,.4); } .btn.cta3:hover { background: linear-gradient(135deg, #e3d6ff, #c9b3f7); }
  .btn.cta1 { background: var(--yl); color: #2a2200; } .btn.cta2 { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.85); padding: 10px 16px; }
  .sidebans { display: grid; gap: 14px; grid-template-rows: 1fr 1fr; }
  .promo { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 4px; border-radius: 16px; padding: 14px 16px; text-decoration: none; color: #fff; box-shadow: var(--shadow); transition: transform .18s, box-shadow .18s; }
  .promo:hover { transform: translateY(-3px); box-shadow: var(--lift); }
  .promo.buyer { background: radial-gradient(circle at 100% 0, rgba(255,255,255,.22) 0 70px, transparent 71px), linear-gradient(135deg, #1d6fb8, #2aa6a0); }
  .promo.seller { background: radial-gradient(circle at 100% 0, rgba(255,255,255,.22) 0 70px, transparent 71px), linear-gradient(135deg, #d9830f, #8fb92b); }
  .promo .pico { position: absolute; right: 12px; top: 8px; font-size: 2.3rem; filter: drop-shadow(0 2px 4px rgba(0,0,0,.25)); }
  .promo .pt { font-size: 1.15rem; padding-right: 48px; } .promo .ps { font-size: .84rem; opacity: .95; padding-right: 20px; line-height: 1.35; }
  .promo ul { list-style: none; margin: 4px 0 0; padding: 0; font-size: .82rem; } .promo li::before { content: "✓ "; font-weight: 700; color: #fff7c2; }
  .promo .pgo { margin-top: auto; align-self: flex-start; background: #fff; color: #14301f; font-weight: 700; font-size: .85rem; border-radius: 999px; padding: 5px 14px; }
  .sideban { position: relative; display: flex; align-items: flex-end; background: linear-gradient(135deg, #fff, var(--g2)); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; text-decoration: none; color: var(--ink); min-height: 143px; padding: 14px 16px; box-shadow: var(--shadow); transition: transform .18s, box-shadow .18s; }
  .sideban:hover { transform: translateY(-3px); box-shadow: 0 10px 26px rgba(16,40,26,.16); }
  .sideban img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sideban span { position: relative; display: flex; flex-direction: column; font-size: 1.05rem; } .sideban small { color: var(--muted); }
  .sideban img + span { color: #fff; background: rgba(0,0,0,.5); padding: 6px 10px; border-radius: 8px; } .sideban img + span small { color: #fff; }

  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 0 0 22px; }
  .duo-card { display: flex; gap: 16px; align-items: center; border-radius: 16px; padding: 18px 20px; box-shadow: var(--shadow); min-width: 0; }
  .duo-ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; font-size: 1.9rem; }
  .duo-body { flex: 1; min-width: 0; } .duo-body h2 { margin: 0 0 4px; font-size: 1.15rem; } .duo-body p { margin: 0 0 10px; font-size: .9rem; line-height: 1.4; }
  .duo-card.trace { background: #fff; border: 1px solid var(--line); } .duo-card.trace .duo-ico { background: var(--g2); } .duo-card.trace p { color: var(--muted); }
  .duo-form { display: flex; gap: 8px; } .duo-form input { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; font: inherit; } .duo-form .btn { flex: none; }
  .duo-card.grower { background: radial-gradient(circle at 92% 12%, rgba(255,255,255,.16) 0 70px, transparent 71px), linear-gradient(135deg, #0f5f2f, #1e9650); color: #fff; } .duo-card.grower .duo-ico { background: rgba(255,255,255,.18); }
  .duo-card.grower p { opacity: .95; } .duo-card.grower .btn { background: var(--yl); color: #2a2200; }
  .soon { background: #fff8e6; border: 1px solid #f3dfa7; border-radius: 12px; padding: 14px; } .soon p { margin: .3em 0 0; }
  .cta { margin-top: 28px; background: radial-gradient(circle at 90% 20%, rgba(255,255,255,.15) 0 80px, transparent 81px), linear-gradient(135deg, #0f5f2f, #1e9650); color: #fff; border-radius: 18px; padding: 26px 28px; display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; box-shadow: var(--shadow); }
  .cta p { opacity: .95; } .cta .btn { background: var(--yl); color: #2a2200; }
  @media (max-width: 1000px) { .hero2 { grid-template-columns: minmax(0, 1fr); } .fly { display: none !important; } .catbox { border-radius: 14px; }
