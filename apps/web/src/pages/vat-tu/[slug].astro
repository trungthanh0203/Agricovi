---
import Base from '../../layouts/Base.astro';
import { catHref, loadCategories, loadMaterial, priceText } from '../../lib/catalog';

const m = await loadMaterial(Astro.params.slug ?? '');
const cats = await loadCategories();
const cat = m ? cats.find((c) => c.id === m.categoryId) : undefined;
if (!m) Astro.response.status = 404;
const jsonLd = m ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'Product', name: m.name, brand: m.brand ? { '@type': 'Brand', name: m.brand } : undefined, description: m.summary || undefined }).replace(/</g, '\\u003c') : '';
---
{m ? (
  <Base title={`${m.name} — Vật tư nông nghiệp`} description={(m.summary || `${m.name} ${m.brand}`).slice(0, 200)}>
    <script type="application/ld+json" set:html={jsonLd} />
    <p class="crumbs"><a href="/">Trang chủ</a> › <a href="/vat-tu/">Vật tư</a>{cat && <> › <a href={catHref(cat)}>{cat.name}</a></>} › {m.name}</p>
    <div class="two">
      <div>
        <h1>{m.name}</h1>
        {m.image && <div class="gallery"><img src={m.image} alt={m.name} /></div>}
        {m.summary && <p>{m.summary}</p>}
        <div class="facts">
          {m.brand && <div><b>Thương hiệu</b>{m.brand}</div>}
          {m.unit && <div><b>Đơn vị</b>{m.unit}</div>}
          {m.shopName ? <div><b>Bán bởi gian hàng</b><a href={`/gian-hang-vat-tu/${m.shopSlug}`}>{m.shopName}</a></div> : (m.distributor && <div><b>Nhà phân phối</b>{m.distributor}</div>)}
        </div>
        {m.ingredients && <div class="panel"><b>Thành phần</b><p style="white-space:pre-line;margin:.3em 0 0">{m.ingredients}</p></div>}
        {m.usage && <div class="panel"><b>Hướng dẫn sử dụng</b><p style="white-space:pre-line;margin:.3em 0 0">{m.usage}</p></div>}
        {m.safety && <div class="panel"><b>Lưu ý an toàn</b><p style="white-space:pre-line;margin:.3em 0 0">{m.safety}</p></div>}
      </div>
      <aside>
        <div class="panel">
          <p class="bigprice">{priceText(m.priceFrom, m.priceNote, m.unit)}</p>
          <p class="muted">Giá tham khảo; giá chính thức theo báo giá.</p>
          <p><a class="btn solid" style="width:100%;text-align:center" href={`/bao-gia/?loai=material&ma=${encodeURIComponent(m.slug)}`}>Yêu cầu báo giá</a></p>
          {m.shopId && <p><button type="button" class="btn sm danger" id="rep" data-mat={m.id}>Báo cáo vật tư này</button></p>}
        </div>
      </aside>
    </div>
  </Base>
) : (
  <Base title="Không tìm thấy vật tư — Agricovi" noindex cache={false}>
    <div class="panel" style="max-width:640px;margin:32px auto;text-align:center">
      <h1>Không tìm thấy vật tư</h1>
      <p><a class="btn solid" href="/vat-tu/">Xem vật tư</a></p>
    </div>
  </Base>
)}

<script>
  import { call, friendly, session } from '../../lib/auth';
  document.getElementById('rep')?.addEventListener('click', async (e) => {
    if (!(await session())) { location.assign('/dang-nhap/?next=' + encodeURIComponent(location.pathname)); return; }
    const r = prompt('Vì sao bạn báo cáo vật tư này? (ít nhất 5 ký tự)');
    if (!r) return;
    try { await call('report_abuse', { p_type: 'material', p_id: (e.currentTarget as HTMLElement).dataset.mat, p_reason: r }); alert('Đã gửi báo cáo. Cảm ơn bạn.'); } catch (x) { alert(friendly(x)); }
  });
</script>
