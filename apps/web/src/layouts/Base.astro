---
import { safeHref } from '@agriconnect/shared';
import { catHref, catTree, loadCategories } from '../lib/catalog';
import { loadChrome } from '../lib/site';

interface Props { title: string; description?: string; noindex?: boolean; cache?: boolean }
const { title, description = 'Danh bạ nhà cung cấp nông sản, vật tư và truy xuất nguồn gốc mùa vụ.', noindex = false, cache = true } = Astro.props;

const chrome = await loadChrome();
const { top: topCats, kids: subCats } = catTree(await loadCategories());
const { settings, header, about, footer } = chrome;
const brand = settings.brand.name ?? 'AgriConnect';
// Song ngữ (middleware): /en/… là bản tiếng Anh của cùng trang
const lang: 'vi' | 'en' = Astro.locals.lang ?? 'vi';
const pathVi = Astro.locals.pathVi ?? Astro.url.pathname;
const withLang = (l: 'vi' | 'en') => new URL((l === 'en' ? (pathVi === '/' ? '/en/' : '/en' + pathVi) : pathVi) + Astro.url.search, Astro.url.origin).toString();
const canonical = withLang(lang).replace(/\?.*$/, '');
const appUrl = import.meta.env.PUBLIC_APP_URL as string | undefined;
const year = new Date().getFullYear();
const social = Object.entries({ Facebook: settings.social.facebook, 'Zalo OA': settings.social.zalo, YouTube: settings.social.youtube, TikTok: settings.social.tiktok })
  .map(([label, href]) => ({ label, href: safeHref(href) })).filter((s) => s.href);

// Trang công khai không chứa dữ liệu riêng của người dùng nên được phép lưu đệm ngắn ở biên Cloudflare
if (cache) Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
else Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b8a4b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'vi_VN'} />
    {noindex ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="alternate" hreflang="vi" href={withLang('vi').replace(/\?.*$/, '')} />
        <link rel="alternate" hreflang="en" href={withLang('en').replace(/\?.*$/, '')} />
        <link rel="alternate" hreflang="x-default" href={withLang('vi').replace(/\?.*$/, '')} />
      </>
    )}
    {lang === 'vi' && <script is:inline set:html={"try{var p=location.pathname;if(localStorage.getItem('lang')==='en'&&p!=='/en'&&p.indexOf('/en/')!==0&&p.indexOf('/admin')!==0&&p.indexOf('/anh/')!==0){location.replace('/en'+p+location.search+location.hash)}}catch(e){}"} />}
  </head>
  <body>
    <header class="site-head">
      <div class="bar1">
        <a class="logo" href="/">{brand}</a>
        <details class="about">
          <summary>Tìm hiểu về {brand}</summary>
          <ul>{about.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </details>
        <nav class="mid" aria-label="Dành cho">
          <a class="yl" href="/danh-cho-nguoi-ban">Dành cho người bán</a>
          <a class="yl" href="/danh-cho-nguoi-mua">Dành cho người mua</a>
        </nav>
        <div class="langsw" role="group" aria-label="Language / Ngôn ngữ"><a href={withLang('vi')} data-lang="vi" aria-current={lang === 'vi' ? 'true' : undefined} lang="vi">VI</a><a href={withLang('en')} data-lang="en" aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a></div>
        <div class="acct" id="acct"><a href="/dang-nhap/">Đăng nhập</a><span aria-hidden="true">|</span><a href="/dang-ky/">Đăng ký</a></div>
      </div>
      <div class="bar2">
        <details class="cats">
          <summary>▦ Danh mục</summary>
          <ul>{topCats.map((c) => (
            <li class="hc"><a href={catHref(c)}>{c.name}{subCats.get(c.id) ? <span aria-hidden="true"> ›</span> : null}</a>
              {subCats.get(c.id) && <ul class="hsub">{subCats.get(c.id)!.map((k) => <li><a href={catHref(k)}>{k.name}</a></li>)}</ul>}</li>
          ))}</ul>
        </details>
        <form class="hsearch" action="/tim-kiem/" method="get" role="search">
          <input name="q" placeholder="Tìm sản phẩm, vật tư, nhà cung cấp" aria-label="Tìm kiếm" />
        </form>
        <nav class="topnav" aria-label="Chuyên mục">
          {header.map((it) => (
            <div class="ni">
              <a href={it.href}>{it.label}</a>
              {it.children && <ul class="sub">{it.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
            </div>
          ))}
        </nav>
        <a class="cart" href="/gio-hang/" id="cartLink">🛒 Giỏ hàng</a>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-foot">
      <div class="fgrid">
        <div class="fabout">
          <b>{brand}</b>
          <p>{settings.brand.description}</p>
          {settings.legal.registration && <p class="reg"><b>Chứng nhận đăng ký</b><br />{settings.legal.registration}</p>}
        </div>
        {footer.map((col) => (
          <div>
            <b>{col.title}</b>
            <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
        <div>
          <b>Thông tin liên hệ</b>
          <ul>
            {settings.contact.hotline && <li>Hotline: {settings.contact.hotline}</li>}
            {settings.contact.email && <li>Email: {settings.contact.email}</li>}
            {settings.contact.address && <li>{settings.contact.address}</li>}
            {!settings.contact.hotline && !settings.contact.email && !settings.contact.address && <li class="muted">Đang cập nhật</li>}
          </ul>
          {social.length > 0 && <><b>Mạng xã hội</b><ul class="soc">{social.map((s) => <li><a href={s.href} rel="noopener nofollow" target="_blank">{s.label}</a></li>)}</ul></>}
        </div>
        <div>
          <b>Dùng trên điện thoại</b>
          <p>Nhà vườn và hợp tác xã cài ứng dụng {brand} lên màn hình chính để ghi chép mọi lúc, kể cả khi mất mạng.</p>
          {safeHref(appUrl) && <a class="btn solid" href={safeHref(appUrl)}>Mở ứng dụng</a>}
        </div>
      </div>
      <div class="fbottom">
        <span>{settings.legal.copyright ?? `© ${year} ${settings.contact.operator ?? brand}`}</span>
        <span class="plinks"><a href="/chinh-sach-bao-mat">Chính sách bảo mật</a><a href="/dieu-khoan-su-dung">Điều khoản sử dụng</a><a href="/quy-che-hoat-dong">Quy chế hoạt động</a></span>
      </div>
      <p class="note">Thông tin do từng cơ sở tự khai và được kiểm duyệt trước khi hiển thị. Nhãn "Tự khai báo" nghĩa là chưa được xác minh độc lập.</p>
    </footer>
    <script>
      // Ngôn ngữ: nhớ lựa chọn ở máy; bản tiếng Anh dịch cả nội dung chèn bằng mã sau khi trang tải (từ điển nạp riêng, chỉ khi cần)
      document.querySelectorAll<HTMLAnchorElement>('.langsw a').forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang ?? 'vi'); } catch { /* bỏ qua */ } }));
      if (document.documentElement.lang === 'en') {
        void import('@agriconnect/shared/src/i18n').then(({ translate, localizePath }) => {
          const SKIP = new Set(['SCRIPT', 'STYLE', 'TEXTAREA', 'CODE', 'PRE']);
          const ATTRS = ['placeholder', 'title', 'aria-label', 'alt'];
          const fixText = (n: Text) => { const p = n.parentElement; if (p && SKIP.has(p.tagName)) return; const t = translate(n.data); if (t !== n.data) n.data = t; };
          const fixEl = (el: Element) => {
            for (const a of ATTRS) { const v = el.getAttribute(a); if (v) { const t = translate(v); if (t !== v) el.setAttribute(a, t); } }
            for (const a of ['href', 'action']) { const v = el.getAttribute(a); if (v && v.startsWith('/')) { const t = localizePath(v, 'en'); if (t !== v) el.setAttribute(a, t); } }
          };
          const walk = (root: Node) => {
            if (root.nodeType === Node.TEXT_NODE) { fixText(root as Text); return; }
            if (root.nodeType !== Node.ELEMENT_NODE) return;
            if (SKIP.has((root as Element).tagName)) return;
            fixEl(root as Element);
            const tw = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
            for (let n = tw.nextNode(); n; n = tw.nextNode()) { if (n.nodeType === Node.TEXT_NODE) fixText(n as Text); else if (!SKIP.has((n as Element).tagName)) fixEl(n as Element); }
          };
          walk(document.documentElement);
          new MutationObserver((muts) => {
            for (const m of muts) {
              if (m.type === 'childList') m.addedNodes.forEach(walk);
              else if (m.type === 'characterData') { if (m.target.nodeType === Node.TEXT_NODE) fixText(m.target as Text); }
              else if (m.type === 'attributes') fixEl(m.target as Element);
            }
          }).observe(document.documentElement, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: [...ATTRS, 'href', 'action'] });
          // hộp thoại của trình duyệt (alert/confirm/prompt) cũng dịch
          const w = window as unknown as Record<string, (...a: unknown[]) => unknown>;
          for (const k of ['alert', 'confirm', 'prompt']) { const o = w[k]!.bind(window); w[k] = (m: unknown, ...r: unknown[]) => o(translate(String(m ?? '')), ...r); }
        });
      }

      // Chỉ đọc dấu hiệu đăng nhập đã lưu ở máy (không nạp thư viện đăng nhập ở mọi trang); dữ liệu thật luôn kiểm ở máy chủ.
      function stored(): { access_token?: string; user?: { email?: string; user_metadata?: { full_name?: string } } } | null {
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i) ?? '';
          if (/^sb-.*-auth-token$/.test(k)) { try { return JSON.parse(localStorage.getItem(k) ?? 'null'); } catch { return null; } }
        }
        return null;
      }
      const s = stored();
      const acct = document.getElementById('acct');
      if (acct && s?.access_token && s.user) {
        const name = s.user.user_metadata?.full_name || (s.user.email ?? '').split('@')[0] || 'Tài khoản';
        acct.innerHTML = '';
        const d = document.createElement('details'); d.className = 'acctm';
        const sum = document.createElement('summary'); sum.textContent = name + ' ▾'; d.appendChild(sum);
        const ul = document.createElement('ul');
        let flags: { org?: boolean; mat?: boolean } = {};
        try { flags = JSON.parse(localStorage.getItem('agriconnect-acc') ?? '{}'); } catch { /* bỏ qua */ }
        const items: [string, string][] = [['Tài khoản của tôi', '/tai-khoan/'], ['Yêu thích', '/tai-khoan/#yeu-thich'], ['Tin giao thương của tôi', '/giao-thuong/cua-toi/'], ['Đơn hàng của tôi', '/don-hang/'], ['Hộp thư', '/hop-thu/'], ['Thông báo', '/thong-bao/']];
        // chỉ người có gian hàng mới thấy liên kết gian hàng (người mua thường không có)
        if (flags.org) items.push(['Gian hàng của tôi (cơ sở sản xuất)', '/gian-hang/']);
        if (flags.mat) items.push(['Gian hàng vật tư của tôi', '/gian-hang-vat-tu/quan-ly/']);
        for (const [label, href] of items) {
          const li = document.createElement('li'); const a = document.createElement('a'); a.href = href as string; a.textContent = label as string; li.appendChild(a); ul.appendChild(li);
        }
        const li = document.createElement('li'); const b = document.createElement('button'); b.type = 'button'; b.textContent = 'Đăng xuất';
        b.addEventListener('click', () => { void import('../lib/auth').then((m) => m.signOut()).then(() => location.assign('/')); });
        li.appendChild(b); ul.appendChild(li); d.appendChild(ul); acct.appendChild(d);
        // chuông thông báo: số chưa đọc (một lệnh gọi nhẹ, chỉ khi đã đăng nhập)
        const bell = document.createElement('a'); bell.href = '/thong-bao/'; bell.className = 'bell'; bell.textContent = '🔔'; bell.title = 'Thông báo'; acct.prepend(bell);
      }

      // Số thông báo chưa đọc và số sản phẩm trong giỏ: MỘT lệnh gọi nhẹ, chỉ khi đã đăng nhập
      const cartLink = document.getElementById('cartLink');
      const bellEl = document.querySelector<HTMLElement>('.bell');
      const paintShell = () => {
        if (!s?.access_token) return;
        void import('../lib/auth').then((m) => m.call<{ unread: number; cart: number }>('web_shell_counts')).then((c) => {
          if (bellEl && c.unread > 0) { bellEl.textContent = '🔔 ' + c.unread; bellEl.classList.add('has'); }
          if (cartLink) cartLink.textContent = c.cart > 0 ? '🛒 Giỏ hàng (' + c.cart + ')' : '🛒 Giỏ hàng';
        }).catch(() => { /* chưa lấy được: bỏ qua */ });
      };
      window.addEventListener('cart:refresh', paintShell);
      paintShell();

      // Nút yêu thích: <button data-fav data-kind="supplier|product" data-ref="..."> (trang hồ sơ và sản phẩm)
      let favs: { suppliers: Set<string>; products: Set<string> } | null = null;
      const paint = () => document.querySelectorAll<HTMLElement>('[data-fav]').forEach((el) => {
        const on = !!favs && (el.dataset.kind === 'supplier' ? favs.suppliers : favs.products).has(el.dataset.ref ?? '');
        el.textContent = on ? '♥ Đã lưu' : el.dataset.kind === 'supplier' ? '♡ Lưu nhà cung cấp' : '♡ Lưu sản phẩm';
        el.dataset.on = on ? '1' : '';
      });
      async function loadFavs() {
        if (!document.querySelector('[data-fav]')) return;   // trang không có nút yêu thích thì khỏi tải danh sách
        if (!s?.access_token) { paint(); return; }
        try {
          const { call } = await import('../lib/auth');
          const f = await call<{ suppliers: { profile_id: string }[]; products: { id: string }[] }>('list_my_favorites');
          favs = { suppliers: new Set(f.suppliers.map((x) => x.profile_id)), products: new Set(f.products.map((x) => x.id)) };
        } catch { favs = null; }
        paint();
      }
      document.addEventListener('click', async (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-fav]');
        if (!el) return;
        e.preventDefault();
        if (!s?.access_token) { location.assign('/dang-nhap/?next=' + encodeURIComponent(location.pathname + location.search)); return; }
        const on = el.dataset.on !== '1';
        try {
          const { call } = await import('../lib/auth');
          await call('toggle_favorite', { p_kind: el.dataset.kind, p_ref: el.dataset.ref, p_on: on });
          if (!favs) favs = { suppliers: new Set(), products: new Set() };
          const set = el.dataset.kind === 'supplier' ? favs.suppliers : favs.products;
          if (on) set.add(el.dataset.ref ?? ''); else set.delete(el.dataset.ref ?? '');
          paint();
        } catch (x) { alert(x instanceof Error ? x.message.replace(/^[A-Z][A-Z_]{3,}: /, '') : 'Chưa lưu được.'); }
      });
      window.addEventListener('fav:refresh', () => void loadFavs());
      void loadFavs();
    </script>
  </body>
</html>

<style is:global>
  :root { --g: #1b8a4b; --g2: #e8f4ec; --ink: #1c2a22; --muted: #5c6b62; --line: #d9e3dc; --warn: #b45309; --yl: #ffe45c; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, "Segoe UI", Roboto, sans-serif; color: var(--ink); background: #f7faf8; line-height: 1.5; }
  a { color: var(--g); }
  main { max-width: 1120px; margin: 0 auto; padding: 16px; min-height: 60vh; }

  .site-head { position: sticky; top: 0; z-index: 20; background: #fff; box-shadow: 0 1px 0 var(--line); }
  .bar1 { background: var(--g); color: #fff; display: flex; align-items: center; gap: 18px; padding: 0 16px 0 0; min-height: 40px; }
  .bar1 a { color: inherit; text-decoration: none; }
  .logo { background: #fff; color: var(--g) !important; font-weight: 700; font-size: 1.1rem; padding: 8px 16px; align-self: stretch; display: flex; align-items: center; }
  .mid { display: flex; gap: 24px; margin: 0 auto; }
  .yl { color: var(--yl) !important; font-weight: 600; }
  .langsw { display: inline-flex; border: 1px solid rgba(255,255,255,.7); border-radius: 6px; overflow: hidden; margin-left: auto; }
  .langsw a { padding: 2px 9px; font-size: .8rem; font-weight: 600; color: #fff; text-decoration: none; } .langsw a[aria-current="true"] { background: #fff; color: var(--g); }
  .acct { display: flex; gap: 8px; align-items: center; white-space: nowrap; }
  .about, .cats { position: relative; }
  .about summary { cursor: pointer; border: 1px solid #fff; border-radius: 4px; padding: 3px 10px; list-style: none; font-size: .9rem; }
  .about summary::after { content: " ▾"; }
  details > summary::-webkit-details-marker { display: none; }
  .about ul, .cats ul { position: absolute; top: calc(100% + 6px); left: 0; min-width: 220px; margin: 0; padding: 8px 0; list-style: none; background: #fff; color: var(--ink); border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,.18); z-index: 30; }
  .about li a, .cats li a { display: block; padding: 8px 16px; color: var(--ink); text-decoration: none; }
  .about li a:hover, .cats li a:hover { background: var(--g2); }
  .bar2 { display: flex; align-items: center; gap: 14px; padding: 8px 16px; max-width: 1280px; margin: 0 auto; }
  .cats summary { cursor: pointer; list-style: none; font-weight: 600; white-space: nowrap; padding: 6px 4px; }
  .hsearch { flex: 0 1 260px; }
  .hsearch input { width: 100%; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: #f3f6f4; font-size: .95rem; }
  .topnav { display: flex; gap: 4px; margin-left: 10px; flex: 1; }
  .ni { position: relative; }
  .ni > a { display: block; padding: 8px 12px; color: var(--ink); text-decoration: none; font-weight: 600; white-space: nowrap; }
  .ni + .ni > a { border-left: 1px solid var(--line); }
  .ni > a:hover { color: var(--g); }
  .sub { display: none; position: absolute; top: 100%; left: 0; min-width: 230px; margin: 0; padding: 8px 0; list-style: none; background: #fff; border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,.18); z-index: 30; }
  .ni:hover .sub, .ni:focus-within .sub { display: block; }
  .sub a { display: block; padding: 8px 16px; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .sub a:hover { background: var(--g2); }
  .cart { color: var(--ink); text-decoration: none; font-weight: 600; white-space: nowrap; margin-left: auto; }

  .site-foot { background: #eef3ef; margin-top: 24px; padding: 24px 16px 12px; font-size: .88rem; color: var(--muted); }
  .fgrid { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr; gap: 20px; }
  .site-foot b { display: block; color: var(--ink); margin-bottom: 6px; }
  .site-foot ul { list-style: none; margin: 0 0 10px; padding: 0; }
  .site-foot li { margin: 4px 0; }
  .site-foot a { color: var(--muted); text-decoration: none; }
  .site-foot a:hover { color: var(--g); text-decoration: underline; }
  .site-foot .btn { color: #fff; }
  .site-foot p { margin: 0 0 8px; }
  .fbottom { max-width: 1120px; margin: 16px auto 0; padding-top: 12px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .plinks { display: flex; gap: 16px; flex-wrap: wrap; }
  .site-foot .note { max-width: 1120px; margin: 8px auto 0; font-size: .8rem; }

  h1 { font-size: 1.6rem; margin: .4em 0; } h2 { font-size: 1.2rem; margin: 1.4em 0 .5em; } h3 { margin: 0 0 .2em; font-size: 1.05rem; }
  .muted { color: var(--muted); } .tag { margin: 0 0 .3em; font-style: italic; }
  .search { display: flex; gap: 8px; flex-wrap: wrap; }
  .search input, .filters input, .filters select { flex: 1 1 200px; padding: 12px; border-radius: 10px; border: 1px solid var(--line); font-size: 1rem; }
  .btn { background: #fff; color: var(--g); border: 0; border-radius: 10px; padding: 12px 18px; font-weight: 600; font-size: 1rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .btn.solid { background: var(--g); color: #fff; }
  .btn.outline { border: 1px solid var(--g); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .card { display: block; background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; text-decoration: none; color: inherit; }
  .card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.08); }
  .card .cover { width: 100%; height: 150px; object-fit: cover; display: block; } .card .ph { display: grid; place-items: center; font-size: 2.5rem; background: var(--g2); }
  .card .body { padding: 12px; } .card .body p { margin: .2em 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .chip { background: var(--g2); color: var(--g); border-radius: 999px; padding: 2px 10px; font-size: .82rem; }
  .pill { display: inline-block; background: #eef1ef; border-radius: 999px; padding: 2px 10px; font-size: .8rem; color: var(--muted); }
  .pill.ok { background: #d9f2e1; color: #14632f; } .pill.pri { background: #fff1d6; color: var(--warn); }
