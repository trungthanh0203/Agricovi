---
import { TRADE_KIND_LABEL } from '@agriconnect/shared';
import { daysLeft, type TradeSummary } from '../lib/trade';
interface Props { t: TradeSummary }
const { t } = Astro.props;
const d = daysLeft(t.expires_at);
---
<a class="tcard" href={`/giao-thuong/tin/${t.id}`}>
  <span class={`tk ${t.kind}`}>{TRADE_KIND_LABEL[t.kind]}</span>
  <h3>{t.title}</h3>
  <p class="m">{t.category_name ?? ''}</p>
  <p class="m">📍 {t.province} · còn {d} ngày</p>
  <p class="lock">🔒 Đăng nhập để xem chi tiết</p>
</a>
<style>
  .tcard { display: block; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; text-decoration: none; color: inherit; }
  .tcard:hover { box-shadow: 0 4px 14px rgba(0,0,0,.08); }
  .tk { display: inline-block; font-size: .75rem; padding: 1px 9px; border-radius: 999px; font-weight: 600; } .tk.buy { background: #e3f4e8; color: #0e5a30; } .tk.sell { background: #fff1d6; color: #7a4b00; }
  h3 { margin: 6px 0 4px; font-size: 1rem; line-height: 1.3; } .m { margin: 2px 0; color: var(--muted); font-size: .85rem; } .lock { margin: 6px 0 0; color: var(--g); font-size: .85rem; font-weight: 600; }
</style>
