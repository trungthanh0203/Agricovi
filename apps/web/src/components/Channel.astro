---
import { DEFAULT_HEADER_NAV, newsSections } from '@agriconnect/shared';
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import Pager from './Pager.astro';
import { loadArticlesPage, type Article } from '../lib/catalog';
import { localizeArticle } from '../lib/translations';

interface Props { channel: Article['channel']; section?: string }
const { channel, section } = Astro.props;

const BASE = { nong_nghiep: '/tin-nong-nghiep/', xuat_khau: '/tin-xuat-khau/', hoi_cho: '/tin-hoi-cho/' } as const;
const base = BASE[channel];
const nav = DEFAULT_HEADER_NAV.find((i) => i.href === base);
const title = nav?.label ?? 'Tin tức';
const hoiCho = channel === 'hoi_cho';
// Tin hội chợ giữ ba mục tính theo ngày; hai chuyên mục còn lại chỉ nhận các mục con thật sự là mục tin (không gồm Giá nông sản, Lịch mùa vụ)
const sections = hoiCho ? (nav?.children ?? []).map((c) => ({ slug: c.href.split('/').filter(Boolean).pop() ?? '', label: c.label })) : newsSections(channel);
const current = section ? sections.find((s) => s.slug === section) : undefined;
if (section && !current) Astro.response.status = 404;

// Tin phân trang ở CSDL (12 bài mỗi trang). Tin hội chợ: trang chính hiện "Sắp diễn ra" (đủ) và "Đã diễn ra" (8 mục mới nhất), từng mục có trang riêng.
const trang = Math.min(Math.max(parseInt(Astro.url.searchParams.get('trang') ?? '1', 10) || 1, 1), 1000);
const tr = (list: Article[]) => list.map((a) => localizeArticle(a, Astro.locals.tr));
let blocks: { heading?: string; items: Article[] }[] = [];
let pg: { page: number; pages: number } | null = null;
let total = 0;
if (channel === 'hoi_cho') {
  if (section === 'sap-dien-ra' || section === 'da-dien-ra' || section === 'lich') {
    const r = await loadArticlesPage(channel, { mode: section === 'sap-dien-ra' ? 'upcoming' : section === 'da-dien-ra' ? 'past' : 'schedule', page: trang, size: 12 });
    blocks = [{ items: tr(r.items) }]; pg = r; total = r.total;
  } else {
    const [up, past] = await Promise.all([loadArticlesPage(channel, { mode: 'upcoming', size: 12 }), loadArticlesPage(channel, { mode: 'past', size: 8 })]);
    blocks = [{ heading: 'Sắp diễn ra', items: tr(up.items) }, { heading: 'Đã diễn ra', items: tr(past.items) }];
    total = up.items.length + past.items.length;
  }
} else {
  const r = await loadArticlesPage(channel, { section: current?.slug, page: trang, size: 12 });
  blocks = [{ items: tr(r.items) }]; pg = r; total = r.total;
}
const heading = current ? `${title}: ${current.label}` : title;
---
{!section || current ? (
  <Base title={`${heading} — Agricovi`} description={`${heading} trên Agricovi.`}>
    <p class="crumbs"><a href="/">Trang chủ</a> › {current ? <><a href={base}>{title}</a> › {current.label}</> : title}</p>
    <h1>{heading}</h1>
    {sections.length > 0 && (
      <div class="subcats">
        <a href={base} class={!current ? 'on' : ''}>Tất cả</a>
        {sections.map((s) => <a href={`${base}${s.slug}/`} class={current?.slug === s.slug ? 'on' : ''}>{s.label}</a>)}
      </div>
    )}
    {total === 0 && <p class="empty">Chưa có nội dung trong mục này. Vui lòng quay lại sau.</p>}
    {blocks.map((b) => b.items.length > 0 && (
      <>
        {b.heading && <h2>{b.heading}</h2>}
        <div class="pgrid">{b.items.map((a) => <ArticleCard a={a} />)}</div>
      </>
    ))}
    {pg && <Pager page={pg.page} pages={pg.pages} />}
  </Base>
) : (
  <Base title="Không tìm thấy mục — Agricovi" noindex cache={false}>
    <div class="panel" style="max-width:640px;margin:32px auto;text-align:center">
      <h1>Không tìm thấy mục này</h1>
      <p><a class="btn solid" href={base}>Về {title}</a></p>
    </div>
  </Base>
)}
