# Sao chép thành .env.local trong từng app (apps/app, apps/admin, apps/web).
# CHỈ đặt khóa công khai (anon) ở đây. KHÔNG bao giờ đặt service_role vào frontend (NFR-SEC-003).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Website công khai (Astro) - chỉ đọc view public_*
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
PUBLIC_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY
